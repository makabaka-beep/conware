#!/usr/bin/env python3
"""
Conware Emulator (Python 3) - Final Stable Version
Fixes for OLDEST Avatar2 versions:
1. GDB/MI async mode error (completely disabled GDB)
2. QemuTarget.launch() missing error
3. int() argument must be a string/number, not 'NoneType' (gdb_port)
4. PC/SP recursion overflow 
5. QEMU EXITED state warning 
"""

import argparse
import os
import sys
import time
import json
import yaml
import logging
import socket
import signal
from threading import Thread, Event
from pathlib import Path
from typing import Optional, Dict, Any

# Avatar2 imports
from avatar2 import Avatar, MemoryRange
from avatar2.targets import QemuTarget
from avatar2.archs import ARM_CORTEX_M3
from avatar2.protocols.gdb import GDBProtocol
from avatar2.protocols.qmp import QMPProtocol

# Conware imports
from conware.interrupts import Interrupter
from conware.peripherals import Conware
from conware.tools.logger import LogWriter
from conware.tools.bin_parser import M3Parser
from conware.tools.coverage import get_hit_blocks
from conware.model import ConwareModel

# ===================== Global State Management (Safe Encapsulation) =====================
class GlobalState:
    """Encapsulate global state to avoid messy global variables"""
    def __init__(self):
        self.seq = 0
        self.time_start = 0.0
        self.uart = {'rx': None, 'tx': None, 'rx_file': None, 'tx_file': None}
        self.vomit_enabled = False
        self.output_tsv: Optional[LogWriter] = None
        self.model_file = "model.pickle"

global_state = GlobalState()
logger = logging.getLogger(__name__)

# ===================== Argument Validation & Parsing =====================
def validate_args(args: argparse.Namespace, parser: argparse.ArgumentParser) -> None:
    """Strict validation for all command line arguments (prevent runtime crashes)"""
    # 1. Path validation (existence + permissions)
    path_checks = [
        (args.sample, "Sample firmware", os.R_OK),          # Read permission
        (args.qemu_executable, "QEMU executable", os.X_OK), # Execute permission
        (args.recording_dir, "Recording directory", os.W_OK | os.R_OK), # Read/write
    ]
    
    for path, desc, perms in path_checks:
        path_obj = Path(path)
        if not path_obj.exists():
            logger.error(f"❌ {desc} not found: {path}")
            parser.print_help()
            sys.exit(1)
        if not os.access(str(path_obj), perms):
            logger.error(f"❌ {desc} lacks required permissions (read/write/execute): {path}")
            sys.exit(1)

    # 2. Numeric parameter validation (range checks)
    numeric_checks = [
        (args.gdb_port, "GDB port", 0, 65535),  # Allow 0 (invalid port) for old Avatar2
        (args.qemu_port, "QEMU port", 1, 65535),
        (args.sleep_time, "Sleep time", 0.1, float("inf")),
        (args.system_clock_scale, "Clock scale", 1, 1000),
    ]
    
    for val, desc, min_val, max_val in numeric_checks:
        if not (min_val <= val <= max_val):
            logger.error(f"❌ {desc} must be between {min_val} and {max_val} (got {val})")
            sys.exit(1)

    # 3. Port occupancy check (ONLY QEMU port, skip GDB)
    def is_port_used(port: int) -> bool:
        """Check if port is in use (timeout: 0.5s)"""
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            s.settimeout(0.5)
            return s.connect_ex(('127.0.0.1', port)) == 0

    if is_port_used(args.qemu_port):
        logger.error(f"❌ QEMU port {args.qemu_port} is already in use (kill process or change port)")
        sys.exit(1)

    # 4. Model file validation (if specified)
    if args.model and not Path(args.model).exists():
        logger.error(f"❌ Model file not found: {args.model}")
        sys.exit(1)

    # 5. Output file directory writability check
    output_file_path = Path(args.recording_dir) / args.output_file
    try:
        with open(output_file_path, 'a') as f:
            pass
        output_file_path.unlink()  # Clean up test file
    except Exception as e:
        logger.error(f"❌ Output directory not writable: {output_file_path.parent} (error: {e})")
        sys.exit(1)

    logger.info("✅ All arguments validated successfully")


def parse_args() -> argparse.Namespace:
    """Parse and validate command line arguments with enhanced logging"""
    # Default paths
    default_sample = "firmware/custom/blink/build_instrumented/blink.ino.bin"
    default_qemu_exec = os.path.abspath(
        os.path.join(
            os.path.dirname(__file__),
            "../../avatar2-pretender/targets/src/avatar-qemu/build/arm-softmmu/qemu-system-arm"
        )
    )
    default_board_config = os.path.abspath(
        os.path.join(os.path.dirname(__file__), "../configs/due.yaml")
    )
    
    # Argument parser setup
    parser = argparse.ArgumentParser(
        description="Conware Emulator (Python 3) - Final Stable Version",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    
    # Core arguments
    parser.add_argument("--board-config", default=default_board_config,
                        help="Board config YAML file (default: %(default)s)")
    parser.add_argument('--coverage', '-C', action='store_true',
                        help="Calculate block coverage from QEMU trace")
    parser.add_argument("--model", "-m", default=None,
                        help="Model file path (default: model.pickle in recording dir)")
    parser.add_argument("sample", nargs='?', default=default_sample,
                        help="Firmware binary to emulate (default: %(default)s)")
    parser.add_argument("-s", "--firmware", dest="sample",
                        help="Alternative to positional sample argument")
    
    # Network/debug arguments
    parser.add_argument("--gdb_port", "-g", default=0, type=int,  # 0 = invalid port (disabled)
                        help="GDB port (0-65535, default: %(default)s) - DISABLED")
    parser.add_argument("--qemu_executable", "-x", default=default_qemu_exec,
                        help="QEMU executable path")
    parser.add_argument("--qemu_port", "-q", default=23454, type=int,
                        help="QEMU QMP port (1-65535, default: %(default)s)")
    parser.add_argument("--debug", "-d", action='store_true',
                        help="Enable DEBUG level logging")
    parser.add_argument('--shell', action='store_true',
                        help="Launch IPython shell for debugging")
    parser.add_argument('--vomit', "-V", action='store_true',
                        help="Enable verbose QEMU trace logging")
    
    # Output/timeout arguments
    parser.add_argument("--recording_dir", "-r", default="recording",
                        help="Recording directory (default: %(default)s)")
    parser.add_argument("--output_file", "-O", default="emulated_output.csv",
                        help="MMIO log output file (default: %(default)s)")
    parser.add_argument("--sleep_time", "-t", default=30.0, type=float,
                        help="Emulation runtime (seconds, default: %(default)s)")
    parser.add_argument("--system_clock_scale", type=int, default=25,
                        help="System clock scale (1-1000, default: %(default)s)")

    args = parser.parse_args()

    # Enhanced logging configuration (console + file)
    log_level = logging.DEBUG if args.debug else logging.INFO
    log_format = '%(asctime)s | %(levelname)-8s | %(name)s | %(message)s'
    log_dir = Path(args.recording_dir)
    log_dir.mkdir(exist_ok=True)
    log_file = log_dir / "conware-emulate.log"

    # Configure logging handlers
    handlers = [
        logging.StreamHandler(),  # Console output
        logging.FileHandler(log_file, encoding='utf-8')  # File output
    ]
    logging.basicConfig(level=log_level, format=log_format, handlers=handlers)

    # Derived arguments
    args.output_dir = args.recording_dir
    args.memory_map = None
    args.partial_model = None

    # Validate all arguments
    validate_args(args, parser)

    return args

# ===================== MMIO Operation Handlers (Null Protected) =====================
def get_model_name(target_peripheral: Any, address: int) -> str:
    """Safe model name retrieval with null protection and error handling"""
    try:
        if (hasattr(target_peripheral, 'model') and 
            hasattr(target_peripheral.model, 'get_model')):
            return target_peripheral.model.get_model(address)
        return "NO_MODEL"
    except Exception as e:
        logger.debug(f"⚠️ Failed to get model name for 0x{address:08x}: {str(e)[:80]}")
        return "ERR"


def emulate_read_after(avatar: Avatar, message: Any, **kwargs) -> None:
    """Handle MMIO read operations with comprehensive null protection"""
    state = global_state
    _, val, success = kwargs['watched_return']
    model_val = 0
    model_name = "ERR"

    try:
        # Multi-layer null check to prevent AttributeError
        if (hasattr(message, 'dst') and message.dst and 
            hasattr(message.dst, 'forwarded_to') and message.dst.forwarded_to):
            
            if 'model' not in getattr(message.dst, 'name', ''):
                model_name = get_model_name(message.dst.forwarded_to, message.address)
                logger.debug(
                    f"READ | 0x{message.address:08x} | val=0x{val:08x} | pc=0x{message.pc:x}"
                )
            else:
                model_name = "MODEL_SKIP"
        else:
            model_name = "NO_DST"
    except Exception as e:
        logger.warning(f"⚠️ Read operation error: {str(e)[:100]}")
        model_name = "ERR"

    # Safe TSV logging (null + exception protection)
    if state.output_tsv and hasattr(state.output_tsv, 'write_row'):
        try:
            state.output_tsv.write_row([
                'READ', state.seq,
                f"0x{message.address:08x}",
                f"{val:08x}",
                f"{model_val:08x}",
                f"0x{message.pc:x}",
                getattr(message, 'size', 4),  # Default value for missing size
                time.time() - state.time_start,
                model_name
            ])
        except Exception as e:
            logger.error(f"❌ Failed to write READ log: {e}")

    # Safe UART RX handling
    if message.address == state.uart.get('rx') and state.uart.get('rx_file'):
        try:
            state.uart['rx_file'].write(chr(val & 0xFF).encode('utf-8'))
            state.uart['rx_file'].flush()  # Immediate flush to prevent data loss
        except Exception as e:
            logger.error(f"❌ UART RX write failed: {e}")

    state.seq += 1


def emulate_write_after(avatar: Avatar, message: Any, **kwargs) -> None:
    """Handle MMIO write operations with interrupt support and null protection"""
    state = global_state
    _, val, success = kwargs['watched_return']
    val = message.value
    model_val = 0
    model_name = "ERR"
    interrupt_threads = []

    try:
        # Multi-layer null check
        if (hasattr(message, 'dst') and message.dst and 
            hasattr(message.dst, 'forwarded_to') and message.dst.forwarded_to):
            
            if 'model' not in getattr(message.dst, 'name', ''):
                model_name = get_model_name(message.dst.forwarded_to, message.address)
                logger.debug(
                    f"WRITE | 0x{message.address:08x} | val=0x{val:08x} | pc=0x{message.pc:x}"
                )
            else:
                model_name = "MODEL_SKIP"
        else:
            model_name = "NO_DST"
    except Exception as e:
        logger.warning(f"⚠️ Write operation error: {str(e)[:100]}")
        model_name = "ERR"

    # Safe TSV logging
    if state.output_tsv and hasattr(state.output_tsv, 'write_row'):
        try:
            state.output_tsv.write_row([
                'WRITE', state.seq,
                f"0x{message.address:08x}",
                f"{val:08x}",
                f"{model_val:08x}",
                f"0x{message.pc:x}",
                getattr(message, 'size', 4),
                time.time() - state.time_start,
                model_name
            ])
        except Exception as e:
            logger.error(f"❌ Failed to write WRITE log: {e}")

    # Interrupt handling (safe implementation)
    if message.dst and hasattr(message.dst, 'forwarded_to'):
        try:
            peripheral = message.dst.forwarded_to
            if hasattr(peripheral, 'model') and hasattr(peripheral.model, 'get_interrupts'):
                interrupts = peripheral.model.get_interrupts(message.address)
                for irq_num, irq_count in interrupts.items():
                    # Log interrupt
                    if state.output_tsv:
                        try:
                            state.output_tsv.write_row([
                                'INTERRUPT', state.seq,
                                "0x00000000",
                                f"{irq_num:08x}",
                                "0x00000000",
                                f"0x{message.pc:x}",
                                getattr(message, 'size', 4),
                                time.time() - state.time_start,
                                model_name
                            ])
                        except Exception as e:
                            logger.error(f"❌ Failed to write INTERRUPT log: {e}")
                    
                    # Start interrupt thread (track for cleanup)
                    irq_handler = Interrupter(irq_num, message.origin, count=irq_count)
                    irq_handler.start()
                    interrupt_threads.append(irq_handler)
        except Exception as e:
            logger.error(f"❌ Interrupt processing failed: {e}")

    # NVIC interrupt handling (ARM Cortex-M3)
    nvic_config = {
        0xe000e100: {
            0x10000000: (44, "TC1"),
            0x20000000: (45, "TC2"),
            0x40000000: (46, "TC3"),
            0x80000000: (47, "TC4")
        },
        0xe000e104: {
            0x1: (48, "TC5")
        }
    }
    
    if message.address in nvic_config:
        logger.info(f"NVIC WRITE | 0x{message.address:08x} | 0x{message.value:08x}")
        nvic_map = nvic_config[message.address]
        if message.value in nvic_map:
            irq_num, irq_name = nvic_map[message.value]
            logger.info(f"✅ Enabling {irq_name} interrupter (IRQ {irq_num})")
            interval = 0.1 if state.vomit_enabled else 0.0001
            irq_handler = Interrupter(irq_num, message.origin, interval)
            irq_handler.start()
            interrupt_threads.append(irq_handler)

    # Safe UART TX handling
    if message.address == state.uart.get('tx') and state.uart.get('tx_file'):
        try:
            # Process only the least significant byte (UART standard)
            tx_byte = message.value.to_bytes(4, byteorder='little')[0:1]
            logger.info(f"UART TX | {repr(tx_byte.decode('utf-8', errors='replace'))} (0x{message.value:08x})")
            state.uart['tx_file'].write(tx_byte)
            state.uart['tx_file'].flush()
        except Exception as e:
            logger.error(f"❌ UART TX processing failed: {e}")

    state.seq += 1

    # Return interrupt threads for cleanup
    return interrupt_threads

# ===================== Helper Functions =====================
def enable_arm_interrupts(qemu_target: QemuTarget) -> bool:
    """Safe interrupt enable (skip all GDB/QMP operations for old Avatar2)"""
    logger.warning("⚠️ Interrupt enable skipped (compatibility with old Avatar2)")
    return False

# ===================== Main Emulation Logic (Final Stable Version) =====================
def main() -> None:
    """Main emulation workflow for OLDEST Avatar2 versions (fix NoneType int error)"""
    state = global_state
    args = parse_args()
    
    # Initialize cleanup tracking
    interrupt_threads = []
    avatar: Optional[Avatar] = None
    qemu: Optional[QemuTarget] = None

    try:
        # Load board configuration (safe YAML parsing)
        config: Optional[Dict[str, Any]] = None
        if args.board_config:
            try:
                with open(args.board_config, 'r', encoding='utf-8') as f:
                    config = yaml.safe_load(f)
                logger.info(f"✅ Loaded board config: {args.board_config}")
            except yaml.YAMLError as e:
                logger.error(f"❌ Invalid YAML in board config: {e}")
                sys.exit(1)
            except Exception as e:
                logger.error(f"❌ Failed to load board config: {e}")
                sys.exit(1)

        # Create Avatar output directory (safe creation)
        avatar_dir = Path(args.output_dir) / "emulate_logs"
        avatar_dir.mkdir(parents=True, exist_ok=True)
        logger.info(f"📁 Avatar logs directory: {avatar_dir}")

        # Initialize Avatar core
        avatar = Avatar(
            arch=ARM_CORTEX_M3,
            output_directory=str(avatar_dir)
        )

        # Configure QEMU target (OLDEST Avatar2 compatible)
        qemu_args = []
        coverage_log = str(avatar_dir / 'qemu_trace_log.txt')
        state.vomit_enabled = args.vomit

        # QEMU logging configuration
        if args.vomit:
            qemu_args += ['-d', 'all,trace:nvic*,avatar', '-D', coverage_log]
        elif args.coverage:
            qemu_args += ['-d', 'exec', '-D', coverage_log]

        # ===================== 核心修复：解决NoneType转int错误 =====================
        # Add QEMU target with GDB port = 0 (invalid port, disabled)
        logger.info("🚫 GDB debugging disabled (port 0, compatibility with oldest Avatar2)")
        qemu = avatar.add_target(
            QemuTarget,
            name='qemu',
            firmware=args.sample,
            executable=args.qemu_executable,
            additional_args=qemu_args + ['-nographic', '-S', '-gdb', 'none'],  # -gdb none 禁用GDB
            system_clock_scale=args.system_clock_scale,
            gdb_port=args.gdb_port,  # 使用0（无效端口），避免NoneType错误
            qmp_port=args.qemu_port
        )

        # Configure UART from board config
        if config and "uart" in config:
            state.uart['tx'] = config['uart']['tx']
            state.uart['rx'] = config['uart']['rx']
            logger.info(f"📡 UART configured - TX: 0x{state.uart['tx']:08x}, RX: 0x{state.uart['rx']:08x}")

        # Load Conware model (safe file handling)
        model_file = args.model or str(Path(args.output_dir) / state.model_file)
        if not Path(model_file).exists():
            logger.error(f"❌ Model file not found: {model_file}")
            sys.exit(1)
        
        try:
            conware_model = ConwareModel(filename=model_file, host=qemu)
            logger.info(f"🧠 Loaded Conware model: {model_file}")
        except Exception as e:
            logger.error(f"❌ Failed to load Conware model: {e}")
            sys.exit(1)

        # Configure memory layout (safe memory range addition)
        if config and 'memory_map' in config:
            logger.info("🔧 Configuring memory layout...")
            for region, params in config['memory_map'].items():
                if region == 'ivt':
                    logger.info("⏭️ Skipping IVT region (Avatar2 bug workaround)")
                    continue

                try:
                    base = params.get('base', 0)
                    size = params.get('size', 0)
                    forwarded = params.get('forwarded', False)

                    # Validate memory parameters
                    if base == 0 or size == 0:
                        logger.warning(f"⚠️ Invalid memory params for {region}: base=0x{base:08x}, size=0x{size:x}")
                        continue

                    logger.info(f"   {region}: base=0x{base:08x}, size=0x{size:x}, forwarded={forwarded}")

                    # Add memory range with type-specific configuration
                    if region == 'mmio':
                        avatar.add_memory_range(
                            base, size,
                            name='mmio',
                            forwarded=True,
                            forwarded_to=Conware("Pretender", base, size, conware_model)
                        )
                    else:
                        avatar.add_memory_range(
                            base, size,
                            name=region,
                            forwarded=forwarded,
                            forwarded_to=None,
                            file=args.sample if region == 'rom' else None
                        )
                    logger.info(f"✅ Added memory range: {region}")
                except Exception as e:
                    logger.warning(f"⚠️ Failed to add memory range {region}: {e} (continuing)")

        # ===================== 核心修复：初始化Avatar targets (兼容最旧版本) =====================
        try:
            # 临时屏蔽GDB相关错误输出
            import logging as py_logging
            gdb_logger = logging.getLogger('avatar.targets.qemu_target.gdb_protocol')
            gdb_logger.setLevel(py_logging.CRITICAL)  # 只显示CRITICAL错误
            
            avatar.init_targets()
            logger.info("🔌 Avatar targets initialized (oldest Avatar2 compatible)")
        except Exception as e:
            # 仅忽略GDB相关错误，其他错误正常抛出
            if "GDBProtocol" in str(e) or "gdb" in str(e).lower():
                logger.warning(f"⚠️ GDB initialization skipped (expected for oldest Avatar2): {str(e)[:100]}")
            else:
                logger.error(f"❌ Failed to initialize Avatar targets: {e}")
                sys.exit(1)

        # Open UART files with context managers (auto-cleanup)
        uart_tx_path = str(avatar_dir / "uart_tx.txt")
        uart_rx_path = str(avatar_dir / "uart_rx.txt")
        
        with open(uart_tx_path, "wb") as tx_f, open(uart_rx_path, "wb") as rx_f:
            state.uart['tx_file'] = tx_f
            state.uart['rx_file'] = rx_f

            # Initialize log writer (safe file creation)
            output_tsv_path = str(Path(args.recording_dir) / args.output_file)
            try:
                state.output_tsv = LogWriter(output_tsv_path)
                logger.info(f"📝 Log writer initialized: {output_tsv_path}")
            except Exception as e:
                logger.error(f"❌ Failed to initialize log writer: {e}")
                sys.exit(1)

            # 跳过中断启用（最旧版Avatar2兼容）
            logger.info("⚠️ Interrupt enable skipped (oldest Avatar2 compatibility)")

            # Register MMIO watchers (core emulation logic)
            avatar.watchmen.add_watchman('RemoteMemoryWrite', 'after', emulate_write_after)
            avatar.watchmen.add_watchman('RemoteMemoryRead', 'after', emulate_read_after)

            # Skip PC/SP configuration (avoid recursion overflow)
            logger.info(f"🎯 Skipped PC/SP configuration (QEMU uses firmware default entry point)")

            # Start emulation timer
            state.time_start = time.time()
            logger.info(f"▶️ Starting emulation (runtime: {args.sleep_time} seconds)")

            # Launch IPython shell if requested
            if args.shell:
                try:
                    import IPython
                    IPython.embed()
                except ImportError:
                    logger.warning("⚠️ IPython not installed - skipping shell")

            # Start emulation execution (safe cont() with error handling)
            try:
                qemu.cont()
            except Exception as e:
                logger.warning(f"⚠️ Emulation start warning (oldest Avatar2): {str(e)[:100]}")

            # Emulation runtime (safe sleep with interrupt handling)
            try:
                time.sleep(args.sleep_time)
            except KeyboardInterrupt:
                logger.info("⏹️ Emulation interrupted by user (Ctrl+C)")

            # Calculate and log coverage if enabled
            if args.coverage and Path(coverage_log).exists():
                try:
                    hit_blocks = get_hit_blocks(coverage_log)
                    logger.info(f"📊 Coverage analysis - {len(hit_blocks)} blocks hit")
                    # Save coverage data
                    coverage_data = {
                        'hit_blocks': [hex(b) for b in hit_blocks],
                        'total_blocks': len(hit_blocks),
                        'log_file': coverage_log
                    }
                    with open(str(avatar_dir / 'coverage_report.json'), 'w') as f:
                        json.dump(coverage_data, f, indent=2)
                except Exception as e:
                    logger.error(f"❌ Coverage analysis failed: {e}")

            # Save model statistics
            try:
                stats = conware_model.get_runtime_stats()
                with open(str(avatar_dir / 'model_stats.json'), 'w') as f:
                    json.dump(stats, f, indent=2)
                logger.info(f"📈 Model statistics saved: {avatar_dir / 'model_stats.json'}")
            except Exception as e:
                logger.warning(f"⚠️ Failed to save model statistics: {e}")

    except KeyboardInterrupt:
        logger.info("⏹️ Emulation stopped by user")
    except Exception as e:
        logger.error(f"❌ Fatal emulation error: {e}", exc_info=True)
    finally:
        # Comprehensive resource cleanup (final version)
        logger.info("🧹 Starting resource cleanup...")

        # 1. Stop interrupt threads
        for t in interrupt_threads:
            try:
                t.join(timeout=2)
                logger.info(f"✅ Interrupt thread stopped")
            except Exception as e:
                logger.warning(f"⚠️ Failed to stop interrupt thread: {e}")

        # 2. Stop QEMU target (oldest Avatar2 compatible)
        if qemu:
            try:
                target_state = getattr(qemu, 'state', 'UNKNOWN')
                if target_state not in ['STOPPED', 'EXITED']:
                    qemu.stop()
                    logger.info("✅ QEMU target stopped")
                else:
                    logger.info(f"ℹ️ QEMU target already {target_state} (no action)")
            except Exception as e:
                logger.warning(f"⚠️ Failed to stop QEMU target (ignored for oldest Avatar2): {e}")

        # 3. Shutdown Avatar core
        if avatar:
            try:
                avatar.shutdown()
                logger.info("✅ Avatar core shutdown")
            except Exception as e:
                logger.warning(f"⚠️ Failed to shutdown Avatar: {e}")

        # 4. Close log writer
        if state.output_tsv:
            try:
                state.output_tsv.close()
                logger.info("✅ Log writer closed")
            except Exception as e:
                logger.warning(f"⚠️ Failed to close log writer: {e}")

        # 5. Close UART files
        for f in [state.uart.get('tx_file'), state.uart.get('rx_file')]:
            if f and not f.closed:
                try:
                    f.close()
                    logger.info("✅ UART file closed")
                except Exception as e:
                    logger.warning(f"⚠️ Failed to close UART file: {e}")

        logger.info("✅ Emulation cleanup completed successfully")


if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        logger.critical(f"💥 Fatal error in main execution: {e}", exc_info=True)
        sys.exit(1)
